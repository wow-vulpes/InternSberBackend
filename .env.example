# Optional Compose overrides; docker compose up works without this file.
# For local Java startup, export these variables: Spring Boot does not read .env.
SERVER_PORT=8080
DB_NAME=kkd
DB_USERNAME=kkd
# Example password for a local development database only.
DB_PASSWORD=kkd_local_example
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/kkd
# Demo data is opt-in and initializes only an empty database.
KKD_DEMO_ENABLED=false
KKD_RUN_ENABLED=false
# Compose uses a separate flag; demo is enabled for its quick start.
COMPOSE_DEMO_ENABLED=true
