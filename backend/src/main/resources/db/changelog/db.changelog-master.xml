        </rollback>
    </changeSet>
    <changeSet id="003-rules-and-issues" author="kkd">
        <sqlFile path="changes/003-rules-and-issues.sql" relativeToChangelogFile="true" splitStatements="false"/>
        <rollback>
            <sqlFile path="rollback/003-rules-and-issues.sql" relativeToChangelogFile="true" splitStatements="false"/>
        </rollback>
    </changeSet>
    <changeSet id="004-guards-and-read-models" author="kkd">
        <sqlFile path="changes/004-guards-and-read-models.sql" relativeToChangelogFile="true" splitStatements="false"/>
