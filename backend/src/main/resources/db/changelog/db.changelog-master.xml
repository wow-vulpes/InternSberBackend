<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   logicalFilePath="db/changelog/db.changelog-master.xml"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">
    <changeSet id="000-baseline" author="kkd">
        <tagDatabase tag="kkd-baseline"/>
    </changeSet>
    <changeSet id="001-source-tables" author="kkd">
        <sqlFile path="changes/001-source-tables.sql" relativeToChangelogFile="true" splitStatements="false"/>
